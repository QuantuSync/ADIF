# Configuración de producción (sesión 2026-10-14). Se copia a deploy/.env
# (`instalar.sh` lo hace solo la primera vez) y se rellena ahí. Este ejemplo
# no lleva ningún secreto: deploy/.env sí, y no se sube nunca al repositorio.
# Las variables sin comentario propio están explicadas en /.env.example y en
# engine/app/config.py.

# --- Máquina -----------------------------------------------------------------

# Dominio público. Caddy pide el certificado para él.
DOMINIO=adif-catalogo-ineco.spaincentral.cloudapp.azure.com
# Carpeta de la máquina con documentos, copias, ficheros de entrada y traspaso.
RUTA_DATOS=/srv/adif

# --- Base de datos -----------------------------------------------------------

POSTGRES_USER=adif
POSTGRES_DB=adif
# `instalar.sh` la genera al azar si se deja así. No cambiarla después de
# arrancar por primera vez: la base ya se creó con ella.
POSTGRES_PASSWORD=CAMBIAR

# --- Acceso ------------------------------------------------------------------

# Minutos sin actividad del usuario tras los que se cierra la sesión.
SESION_INACTIVIDAD_MINUTOS=30
# Horas tras las que se cierra en todo caso.
SESION_DURACION_MAXIMA_HORAS=12
# Fallos que bloquean un usuario (o una dirección) durante la ventana.
ACCESO_MAX_FALLOS_USUARIO=5
ACCESO_MAX_FALLOS_IP=20
ACCESO_VENTANA_MINUTOS=15
CONTRASENA_LONGITUD_MINIMA=12

# --- Modelo de IA ------------------------------------------------------------
# Solo hace falta para leer documentos escaneados nuevos y tablas con una
# cabecera nunca vista. Sin clave, todo lo demás funciona y lo ya leído sigue
# en caché; la pantalla de Mantenimiento avisa.
#
# Servicio de IA del cliente (protocolo de chat de OpenAI):
#   MODEL_PROVEEDOR=openai
#   MODEL_ENDPOINT=https://<recurso>.openai.azure.com/openai/v1
#   MODEL_ID=<nombre del despliegue, con visión para leer escaneados>
#   MODEL_API_KEY=<clave del recurso>
# Con el formato antiguo por despliegue:
#   MODEL_ENDPOINT=https://<recurso>.openai.azure.com/openai/deployments/<despliegue>
#   MODEL_API_VERSION=2024-10-21
#
# API de siempre: MODEL_PROVEEDOR=anthropic, MODEL_ID y MODEL_API_KEY.
MODEL_PROVEEDOR=openai
MODEL_ENDPOINT=
MODEL_API_VERSION=
MODEL_ID=
MODEL_API_KEY=
MODEL_WORKSPACE_ID=
OCR_MODO=escaneados
OCR_MODELO_RELECTURA=

# --- Copias de seguridad de la base ------------------------------------------
# Las hace el worker y las deja en RUTA_DATOS/copias (adif_AAAAMMDD_HHMMSS.dump).

BACKUP_ACTIVO=true
# Cada cuánto, en segundos (86400 = una al día).
BACKUP_INTERVALO_SEGUNDOS=86400
# Cuántas se guardan; las más antiguas se borran solas.
BACKUP_RETENCION=14

# --- Mantenimiento automático ------------------------------------------------

MANTENIMIENTO_PROGRAMADO_ACTIVO=true
MANTENIMIENTO_INTERVALO_SEGUNDOS=604800
DESCUBRIMIENTO_PEDIDOS_ACTIVO=true
SINDICACION_DEPARTAMENTOS_ADIF=28510
BUSQUEDA_DESCUBRIMIENTO_ACTIVO=true
BUSQUEDA_FRAGMENTOS=
SCRAPING_SEPARACION_MINIMA_SEGUNDOS=10
SIN_PUBLICAR_REINTENTO_DIAS=14
SIN_PUBLICAR_REINTENTOS_POR_CICLO=50
SIN_PUBLICAR_REINTENTO_DIAS_RECIENTES=3
SIN_PUBLICAR_ANIOS_RECIENTES=1

# --- Ficheros de entrada del cliente -----------------------------------------
# Rutas DENTRO del contenedor: RUTA_DATOS/entrada de la máquina se ve como
# /data/entrada. Vacías, el sistema no los lee (los datos ya cargados siguen
# en la base). Para volver a cargar uno, dejarlo en RUTA_DATOS/entrada y poner
# aquí su ruta, por ejemplo /data/entrada/maestro_materiales.xlsx.

CODIGOS_PROYECTO_PATH=
ESTADO_SAP_PATH=
ESTADOS_ADIF_PATH=
SAP_DESGLOSE_PATH=
MAESTRO_MATERIALES_PATH=
EN_EJECUCION_ADIF_DIR=/data/entrada
VIGENTES_REMANENTE_PATH=
CATALOGO_ANTIGUO_PATH=
EXCLUSION_EXPEDIENTES_PATH=
EXCLUSION_PALABRAS_TITULO_PATH=
INGESTA_LOCAL_PATH=
