POSTGRES_USER=adif
POSTGRES_PASSWORD=adif
POSTGRES_DB=adif
API_URL=http://api:8000
# Orígenes del navegador desde los que se llama a la API (CORS). Sepáralos
# por comas -- "localhost" y "127.0.0.1" son orígenes distintos para el
# navegador aunque resuelvan al mismo sitio, así que van los dos por
# defecto (sesión de diagnóstico "Failed to fetch", 2026-09-06).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Mapeo de cabecera de cuadro de precios (CONTEXTO.md sección 6): única etapa
# de la cascada de extracción que llama al modelo, y solo una vez por firma
# de cabecera nunca vista.
MODEL_API_KEY=
# Identificador de modelo del proveedor configurado. Sin valor por defecto
# en el repositorio a propósito -- depende del proveedor elegido en cada
# despliegue. Un modelo pequeño basta: la tarea es traducir una cabecera de
# tabla a un diccionario de pocas claves, no razonamiento (CONTEXTO.md
# sección 6).
MODEL_ID=
# Solo si MODEL_API_KEY es una clave ligada a identidad (creada en la
# consola bajo un usuario, no una clave clásica de workspace) — ver
# docstring de APIModelProvider.
MODEL_WORKSPACE_ID=

# Solo desarrollo local (ver docstring de CachedModelProvider): cachea en
# disco la respuesta de cada llamada al modelo para no pagar la misma
# cabecera dos veces mientras se itera. Vacío en producción. El
# docker-compose del worker ya monta ./engine/.cache_modelo_dev en esta
# ruta del contenedor; solo hace falta rellenar la variable para activarla.
MODEL_CACHE_DIR=/app/.cache_modelo_dev

# Cruce con el Excel de códigos (CONTEXTO.md sección 7): ruta DENTRO del
# contenedor a `Expedientes.xlsx`. Vacío por defecto (ningún expediente
# cruza). Para activarlo en local, monta tu fichero real con un
# docker-compose.override.yml, por ejemplo:
#   services:
#     api:
#       volumes: ["./Ejemplo/Input/Códigos de proyecto.xlsx:/data/codigos_proyecto.xlsx:ro"]
#     worker:
#       volumes: ["./Ejemplo/Input/Códigos de proyecto.xlsx:/data/codigos_proyecto.xlsx:ro"]
CODIGOS_PROYECTO_PATH=/data/codigos_proyecto.xlsx

# Lista de exclusión de expedientes (app/exclusion.py): fichero de texto
# plano, una entrada por línea -- código exacto ("6.24/28510.0088"),
# departamento completo ("28520") o código interno ("INTERNO:24038"), "#"
# para comentarios. Solo esconde de GET /catalogo y el Excel entregado,
# nunca de la base de datos. Vacío por defecto: no excluye nada.
EXCLUSION_EXPEDIENTES_PATH=

# Bloque 3, sesión de comparación documento-vs-listado interno: filtro por
# palabras del título del contrato (app/exclusion.py,
# ExclusionPalabrasTitulo) -- mismo formato que EXCLUSION_EXPEDIENTES_PATH
# de arriba, pero una palabra o frase de texto libre por línea (p.ej.
# "arrendamiento", "gestión de residuos"). Mismo alcance: solo esconde de
# GET /catalogo y el Excel, nunca de la base de datos ni de la descarga.
EXCLUSION_PALABRAS_TITULO_PATH=

# Bloque 2, descubrimiento por sindicación (CONTEXTO.md sección 24):
# departamentos de ADIF que el sistema da de alta solos al encontrarlos
# publicados. Lista separada por comas -- añadir un departamento nuevo es
# cambiar esta variable, nunca tocar código.
SINDICACION_DEPARTAMENTOS_ADIF=28510

# Bloque 6, sesión de comparación documento-vs-listado interno: segunda vía
# de ingesta (app/ingesta_local.py) -- expedientes vigentes en el SAP del
# cliente que no están publicados en la Plataforma, aportados por una macro
# propia. Una subcarpeta por expediente dentro de esta ruta, nombrada con el
# código saneado (p.ej. "6.24_28510.0088/") -- ver
# docs/ingesta-manual-convencion-carpetas.md. Vacío por defecto: no hace
# nada. Para activarlo en local, monta la carpeta con un
# docker-compose.override.yml:
#   services:
#     worker:
#       volumes: ["./mi-carpeta-de-ingesta:/data/ingesta_local:ro"]
INGESTA_LOCAL_PATH=/data/ingesta_local
